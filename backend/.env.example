# Copy to ".env" in this folder (backend/.env) and adjust values.
# Never commit .env — it is listed in .gitignore.
#
# Load before running Maven (examples at end of this file).

# --- HTTP ---
SERVER_PORT=8080

# --- PostgreSQL (matches backend/docker-compose.yml defaults) ---
# If you see "database wms does not exist": use Docker (see backend/README.md) or run
#   psql -U postgres -h localhost -f backend/db/create-wms-database.sql
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wms
SPRING_DATASOURCE_USERNAME=wms
SPRING_DATASOURCE_PASSWORD=wms

# --- JWT (use a long random string in production; minimum ~32 characters) ---
JWT_SECRET=change-me-use-a-long-random-secret-at-least-32-chars

# Optional: token lifetime in ms (default 86400000 = 24h)
# JWT_EXPIRATION_MS=86400000
